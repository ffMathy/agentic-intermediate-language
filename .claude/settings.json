{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/src/cli.ts\" hook pre" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/src/cli.ts\" hook post" }]
      }
    ]
  }
}
