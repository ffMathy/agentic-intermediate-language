{
  "name": "ail",
  "displayName": "AIL: Agentic Intermediate Language",
  "description": "Syntax highlighting for AIL specs: .ail.md files and ```ail blocks in Markdown.",
  "version": "0.1.0",
  "publisher": "ffMathy",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ffMathy/agentic-intermediate-language",
    "directory": "editors/vscode"
  },
  "homepage": "https://ffmathy.github.io/agentic-intermediate-language/",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ail",
    "specification",
    "spec",
    "markdown",
    "agents"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ail",
        "aliases": [
          "AIL",
          "ail"
        ],
        "extensions": [
          ".ail"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ail",
        "scopeName": "source.ail",
        "path": "./syntaxes/ail.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ail.codeblock",
        "path": "./syntaxes/ail.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ail": "ail"
        }
      }
    ]
  }
}
